<Project>
  <!--
    One self-contained ScreenCap.exe: no .NET runtime needed on the target PC.
    dotnet publish src/ScreenCap -p:PublishProfile=SingleFile
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs (wpfgfx, PresentationNative, …) are bundled too and unpacked on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Not compressed: compression shrinks the exe from ~190 MB to ~80 MB, but the assemblies are then unpacked
      into memory at startup, costing ~120 MB more for as long as ScreenCap runs in the tray.
      Add -p:EnableCompressionInSingleFile=true for a smaller download.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
