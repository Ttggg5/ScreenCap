<UserControl x:Class="ScreenCap.Capture.SelectionToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Cursor="Arrow">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE4F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE4F7" />
                                <Setter Property="Foreground" Value="#1A73E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#55000000"
                                BorderThickness="1" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1A73E8" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SizeDot" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Fill" Value="#22000000" />
        </Style>
    </UserControl.Resources>

    <Border Background="#F8FFFFFF" CornerRadius="6" BorderBrush="#33000000" BorderThickness="1" Padding="3">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="EditTools" Orientation="Horizontal">
                <ToggleButton x:Name="RectangleTool" Style="{StaticResource ToolToggle}" ToolTip="矩形" Content="&#x25AD;" Click="OnToolClick" />
                <ToggleButton x:Name="EllipseTool" Style="{StaticResource ToolToggle}" ToolTip="橢圓" Content="&#x25EF;" Click="OnToolClick" />
                <ToggleButton x:Name="ArrowTool" Style="{StaticResource ToolToggle}" ToolTip="箭頭" Content="&#x2197;" Click="OnToolClick" />
                <ToggleButton x:Name="PenTool" Style="{StaticResource ToolToggle}" ToolTip="畫筆" Content="&#x270E;" Click="OnToolClick" />
                <ToggleButton x:Name="HighlighterTool" Style="{StaticResource ToolToggle}" ToolTip="螢光筆" Content="&#xE7E6;" FontFamily="{StaticResource IconFont}" FontSize="15" Click="OnToolClick" />
                <ToggleButton x:Name="TextTool" Style="{StaticResource ToolToggle}" ToolTip="文字" Content="T" FontFamily="Georgia" FontWeight="Bold" Click="OnToolClick" />
                <ToggleButton x:Name="NumberTool" Style="{StaticResource ToolToggle}" ToolTip="序號標記" Content="&#x2460;" Click="OnToolClick" />
                <ToggleButton x:Name="MosaicTool" Style="{StaticResource ToolToggle}" ToolTip="馬賽克" Content="&#x25A6;" Click="OnToolClick" />
                <Rectangle Style="{StaticResource Divider}" />
                <Button Style="{StaticResource ToolButton}" ToolTip="復原 (Ctrl+Z)" Content="&#xE7A7;" Click="OnUndo" />
                <Button Style="{StaticResource ToolButton}" ToolTip="重做 (Ctrl+Y)" Content="&#xE7A6;" Click="OnRedo" />
                <Rectangle Style="{StaticResource Divider}" />
                <Button Style="{StaticResource ToolButton}" ToolTip="貼到桌面 (Ctrl+T)" Content="&#xE718;" Click="OnPin" />
                <Button Style="{StaticResource ToolButton}" ToolTip="另存新檔 (Ctrl+S)" Content="&#xE74E;" Click="OnSave" />
                </StackPanel>
                <StackPanel x:Name="FormatOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <ToggleButton x:Name="GifFormat" Style="{StaticResource ToolToggle}" Width="40" Content="GIF" ToolTip="錄成 GIF 動畫"
                                  FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Click="OnFormatClick" />
                    <ToggleButton x:Name="Mp4Format" Style="{StaticResource ToolToggle}" Width="40" Content="MP4" ToolTip="錄成 MP4 影片"
                                  FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Click="OnFormatClick" />
                    <Rectangle Style="{StaticResource Divider}" />
                </StackPanel>
                <Button x:Name="RecordButton" Style="{StaticResource ToolButton}" ToolTip="錄製螢幕" Content="&#xE714;" Click="OnRecord" />
                <TextBlock x:Name="RecordLabel" Text="開始錄製 (Enter)" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="#333333" FontFamily="Microsoft JhengHei UI" FontSize="12" Visibility="Collapsed" />
                <Button Style="{StaticResource ToolButton}" ToolTip="取消 (Esc)" Content="&#xE711;" Foreground="#D93025" Click="OnCancel" />
                <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" ToolTip="複製到剪貼簿 (Enter)" Content="&#xE73E;" Foreground="#188038" Click="OnCopy" />
            </StackPanel>

            <StackPanel x:Name="OptionsRow" Orientation="Horizontal" Margin="0,3,0,1" Visibility="Collapsed">
                <StackPanel x:Name="MosaicOptions" Orientation="Horizontal" Visibility="Collapsed" Height="24">
                    <TextBlock Text="模糊度" VerticalAlignment="Center" Margin="6,0,8,0" Foreground="#333333"
                               FontFamily="Microsoft JhengHei UI" FontSize="12" />
                    <Slider x:Name="MosaicSlider" Width="140" Minimum="1" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" Focusable="False" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="OnMosaicSliderPressed" ValueChanged="OnMosaicSliderChanged" />
                    <TextBlock x:Name="MosaicValue" Width="22" VerticalAlignment="Center" TextAlignment="Right"
                               Margin="4,0,6,0" Foreground="#333333" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
                <StackPanel x:Name="StrokeOptions" Orientation="Horizontal">
                <ToggleButton x:Name="SizeSmall" Style="{StaticResource SizeDot}" Tag="2" ToolTip="細" Click="OnSizeClick">
                    <Ellipse Width="4" Height="4" Fill="#333333" />
                </ToggleButton>
                <ToggleButton x:Name="SizeMedium" Style="{StaticResource SizeDot}" Tag="4" ToolTip="中" Click="OnSizeClick">
                    <Ellipse Width="8" Height="8" Fill="#333333" />
                </ToggleButton>
                <ToggleButton x:Name="SizeLarge" Style="{StaticResource SizeDot}" Tag="6" ToolTip="粗" Click="OnSizeClick">
                    <Ellipse Width="12" Height="12" Fill="#333333" />
                </ToggleButton>
                <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <Rectangle Style="{StaticResource Divider}" Margin="4,2" />
                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource SizeDot}" ToolTip="粗體" Content="B"
                                  FontFamily="Georgia" FontWeight="Bold" FontSize="14" Click="OnTextStyleClick" />
                    <ToggleButton x:Name="BackgroundToggle" Style="{StaticResource SizeDot}" ToolTip="文字底色" Click="OnTextStyleClick">
                        <Border Background="#333333" CornerRadius="2" Padding="3,0">
                            <TextBlock Text="A" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" />
                        </Border>
                    </ToggleButton>
                </StackPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="4,2" />
                <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Swatch}" Background="#E53935" ToolTip="紅" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#EC407A" ToolTip="粉紅" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#FB8C00" ToolTip="橘" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#FDD835" ToolTip="黃" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#7CB342" ToolTip="黃綠" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#43A047" ToolTip="綠" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#00ACC1" ToolTip="青" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#1E88E5" ToolTip="藍" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#3949AB" ToolTip="靛" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#8E24AA" ToolTip="紫" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#6D4C41" ToolTip="棕" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#9E9E9E" ToolTip="灰" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#000000" ToolTip="黑" Click="OnColorClick" />
                    <ToggleButton Style="{StaticResource Swatch}" Background="#FFFFFF" ToolTip="白" Click="OnColorClick" />
                </StackPanel>
                <ToggleButton x:Name="CustomSwatch" Style="{StaticResource Swatch}" Visibility="Collapsed" ToolTip="自訂顏色" Click="OnColorClick" />
                <ToggleButton x:Name="PaletteToggle" Style="{StaticResource SizeDot}" ToolTip="調色盤" Margin="2,0,0,0" Click="OnPaletteClick">
                    <Ellipse Width="16" Height="16" Stroke="#55000000" StrokeThickness="1">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E53935" Offset="0" />
                                <GradientStop Color="#FDD835" Offset="0.25" />
                                <GradientStop Color="#43A047" Offset="0.5" />
                                <GradientStop Color="#1E88E5" Offset="0.75" />
                                <GradientStop Color="#8E24AA" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </ToggleButton>
                </StackPanel>
            </StackPanel>

            <ContentControl x:Name="PaletteHost" Visibility="Collapsed" Focusable="False" />
        </StackPanel>
    </Border>
</UserControl>
