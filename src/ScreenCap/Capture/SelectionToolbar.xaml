<UserControl x:Class="ScreenCap.Capture.SelectionToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenCap.Capture"
             x:ClassModifier="internal"
             FontFamily="Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI"
             Cursor="Arrow">
    <!-- Colors are DynamicResources from ThemeManager so the toolbar follows light/dark mode. -->
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Margin="1">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Fluent-style selection pill under the active tool -->
                            <Border x:Name="Pill" Width="14" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                    Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round color swatch; the selected one gets an accent ring -->
        <Style x:Key="Swatch" TargetType="ToggleButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="Transparent" />
                            <Ellipse x:Name="Dot" Margin="4" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Brush.Divider}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Margin" Value="3" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SizeDot" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="5,7" />
            <Setter Property="Fill" Value="{DynamicResource Brush.Divider}" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Toolbar}" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="EditTools" Orientation="Horizontal">
                    <ToggleButton x:Name="RectangleTool" Style="{StaticResource ToolToggle}" ToolTip="矩形" Content="&#xE739;" Click="OnToolClick" />
                    <ToggleButton x:Name="EllipseTool" Style="{StaticResource ToolToggle}" ToolTip="橢圓" Content="&#xEA3A;" Click="OnToolClick" />
                    <ToggleButton x:Name="ArrowTool" Style="{StaticResource ToolToggle}" ToolTip="箭頭" Content="&#xE72A;" Click="OnToolClick" />
                    <ToggleButton x:Name="LineTool" Style="{StaticResource ToolToggle}" ToolTip="直線" Click="OnToolClick">
                        <Line X1="2" Y1="14" X2="14" Y2="2" Width="16" Height="16" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>
                    <ToggleButton x:Name="PolylineTool" Style="{StaticResource ToolToggle}" ToolTip="折線：逐點點擊，雙擊或 Enter 結束" Click="OnToolClick">
                        <Polyline Points="1.5,13 6,4.5 10.5,10.5 15,2.5" Width="17" Height="16" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>
                    <ToggleButton x:Name="PenTool" Style="{StaticResource ToolToggle}" ToolTip="畫筆" Content="&#xE70F;" Click="OnToolClick" />
                    <ToggleButton x:Name="HighlighterTool" Style="{StaticResource ToolToggle}" ToolTip="螢光筆" Content="&#xE7E6;" Click="OnToolClick" />
                    <ToggleButton x:Name="TextTool" Style="{StaticResource ToolToggle}" ToolTip="文字" Content="&#xE97E;" Click="OnToolClick" />
                    <ToggleButton x:Name="CalloutTool" Style="{StaticResource ToolToggle}" ToolTip="對話框：從要指的位置拖曳到放文字的地方" Click="OnToolClick">
                        <Path Width="18" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M 2,1 H 16 A 1.5,1.5 0 0 1 17.5,2.5 V 9.5 A 1.5,1.5 0 0 1 16,11 H 8 L 4,15 V 11 H 2 A 1.5,1.5 0 0 1 0.5,9.5 V 2.5 A 1.5,1.5 0 0 1 2,1 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>
                    <ToggleButton x:Name="NumberTool" Style="{StaticResource ToolToggle}" ToolTip="序號標記" Click="OnToolClick">
                        <Border Width="17" Height="17" CornerRadius="8.5" BorderThickness="1.5"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                            <TextBlock Text="1" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </Border>
                    </ToggleButton>
                    <ToggleButton x:Name="MosaicTool" Style="{StaticResource ToolToggle}" ToolTip="馬賽克 / 模糊" Content="&#xE80A;" Click="OnToolClick" />
                    <ToggleButton x:Name="MagnifierTool" Style="{StaticResource ToolToggle}" ToolTip="放大鏡：框選要放大的範圍" Content="&#xE71E;" Click="OnToolClick" />
                    <ToggleButton x:Name="SpotlightTool" Style="{StaticResource ToolToggle}" ToolTip="聚光燈：框選的範圍以外調暗" Click="OnToolClick">
                        <Grid Width="18" Height="16">
                            <Rectangle RadiusX="2" RadiusY="2" Opacity="0.45"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            <Rectangle Width="9" Height="7" RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.Toolbar}" />
                            <Rectangle Width="9" Height="7" RadiusX="1" RadiusY="1" StrokeThickness="1.2"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </Grid>
                    </ToggleButton>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="復原 (Ctrl+Z)" Content="&#xE7A7;" Click="OnUndo" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="重做 (Ctrl+Y)" Content="&#xE7A6;" Click="OnRedo" />
                    <Rectangle Style="{StaticResource Divider}" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="文字辨識 (OCR)" Content="&#xE8AC;" Click="OnOcr" />
                    <Button x:Name="PinButton" Style="{StaticResource ToolButton}" ToolTip="貼到桌面 (Ctrl+T)" Content="&#xE718;" Click="OnPin" />
                    <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" ToolTip="另存新檔 (Ctrl+S)" Content="&#xE74E;" Click="OnSave" />
                    <Button x:Name="ScrollCaptureButton" Style="{StaticResource ToolButton}" ToolTip="長截圖：自動捲動並拼接" Content="&#xECE7;" Click="OnScrollCapture" />
                </StackPanel>
                <StackPanel x:Name="FormatOptions" Orientation="Horizontal" Visibility="Collapsed">
                    <ToggleButton x:Name="GifFormat" Style="{StaticResource ToolToggle}" Width="44" Content="GIF" ToolTip="錄成 GIF 動畫"
                                  FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Click="OnFormatClick" />
                    <ToggleButton x:Name="Mp4Format" Style="{StaticResource ToolToggle}" Width="44" Content="MP4" ToolTip="錄成 MP4 影片"
                                  FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Click="OnFormatClick" />
                    <Rectangle Style="{StaticResource Divider}" />
                </StackPanel>
                <Button x:Name="RecordButton" Style="{StaticResource ToolButton}" ToolTip="錄製螢幕" Content="&#xE714;" Click="OnRecord" />
                <TextBlock x:Name="RecordLabel" Text="開始錄製 (Enter)" Style="{StaticResource Label}" Margin="0,0,8,0" Visibility="Collapsed" />
                <Rectangle Style="{StaticResource Divider}" />
                <Button Style="{StaticResource ToolButton}" ToolTip="取消 (Esc)" Content="&#xE711;" Foreground="{DynamicResource Brush.Danger}" Click="OnCancel" />
                <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" ToolTip="複製到剪貼簿 (Enter)" Content="&#xE8FB;" Foreground="{DynamicResource Brush.Success}" Click="OnCopy" />
            </StackPanel>

            <StackPanel x:Name="OptionsRow" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                <StackPanel x:Name="MosaicOptions" Orientation="Horizontal" Visibility="Collapsed" Height="26">
                    <ToggleButton x:Name="PixelateStyle" Style="{StaticResource SizeDot}" Width="56" Content="馬賽克" ToolTip="馬賽克方塊"
                                  FontFamily="Microsoft JhengHei UI" FontSize="12" Click="OnMosaicStyleClick" />
                    <ToggleButton x:Name="BlurStyle" Style="{StaticResource SizeDot}" Width="48" Content="模糊" ToolTip="高斯模糊"
                                  FontFamily="Microsoft JhengHei UI" FontSize="12" Click="OnMosaicStyleClick" />
                    <Rectangle Style="{StaticResource Divider}" Margin="5,4" />
                    <TextBlock Text="強度" Style="{StaticResource Label}" Margin="4,0,10,0" />
                    <Slider x:Name="MosaicSlider" Width="150" Minimum="1" Maximum="10" TickFrequency="1"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" ValueChanged="OnMosaicSliderChanged" />
                    <local:NumberBox x:Name="MosaicValue" Minimum="1" Maximum="10" Margin="6,0,6,0" />
                </StackPanel>
                <StackPanel x:Name="SpotlightOptions" Orientation="Horizontal" Visibility="Collapsed" Height="26">
                    <TextBlock Text="其餘部分調暗" Style="{StaticResource Label}" Margin="4,0,10,0" />
                    <Slider x:Name="DimSlider" Width="150" Minimum="10" Maximum="90" SmallChange="5" LargeChange="10" TickFrequency="5"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" ValueChanged="OnDimSliderChanged" />
                    <local:NumberBox x:Name="DimValue" Minimum="10" Maximum="90" Suffix="%" Margin="6,0,6,0" />
                </StackPanel>
                <StackPanel x:Name="StrokeOptions" Orientation="Horizontal">
                    <TextBlock x:Name="SizeLabel" Text="粗細" Style="{StaticResource Label}" Margin="4,0,6,0" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="1" Maximum="20" SmallChange="1" LargeChange="2" TickFrequency="1"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" ValueChanged="OnSizeSliderChanged" />
                    <local:NumberBox x:Name="SizeValue" Margin="6,0,2,0" />
                    <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <Rectangle Style="{StaticResource Divider}" Margin="5,4" />
                        <ComboBox x:Name="FontBox" Width="150" Height="26" Focusable="False" VerticalAlignment="Center" FontSize="12" ToolTip="字型"
                                  VirtualizingPanel.IsVirtualizing="True" MaxDropDownHeight="360"
                                  DropDownOpened="OnFontDropDownOpened" SelectionChanged="OnFontChanged" />
                        <ToggleButton x:Name="BoldToggle" Style="{StaticResource SizeDot}" ToolTip="粗體" Content="&#xE8DD;" FontSize="14" Margin="4,0,0,0" Click="OnTextStyleClick" />
                        <ToggleButton x:Name="ItalicToggle" Style="{StaticResource SizeDot}" ToolTip="斜體" Content="&#xE8DB;" FontSize="14" Click="OnTextStyleClick" />
                        <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource SizeDot}" ToolTip="底線" Content="&#xE8DC;" FontSize="14" Click="OnTextStyleClick" />
                        <ToggleButton x:Name="BackgroundToggle" Style="{StaticResource SizeDot}" ToolTip="文字底色" Click="OnTextStyleClick">
                            <Border CornerRadius="3" Padding="3,0,3,1"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                <TextBlock Text="A" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Toolbar}" />
                            </Border>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel x:Name="ShapeOptions" Orientation="Horizontal" Visibility="Collapsed">
                        <Rectangle Style="{StaticResource Divider}" Margin="5,4" />
                        <ToggleButton x:Name="FillToggle" Style="{StaticResource SizeDot}" ToolTip="填滿" Click="OnShapeStyleClick">
                            <Rectangle Width="14" Height="11" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                        <ToggleButton x:Name="DashToggle" Style="{StaticResource SizeDot}" ToolTip="虛線" Click="OnShapeStyleClick">
                            <Line X1="1" Y1="6" X2="16" Y2="6" Width="17" Height="12" StrokeThickness="2" StrokeDashArray="1.5 1.25"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                    </StackPanel>
                    <Rectangle Style="{StaticResource Divider}" Margin="5,4" />
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource Swatch}" Background="#E53935" ToolTip="紅" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#EC407A" ToolTip="粉紅" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#FB8C00" ToolTip="橘" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#FDD835" ToolTip="黃" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#7CB342" ToolTip="黃綠" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#43A047" ToolTip="綠" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#00ACC1" ToolTip="青" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#1E88E5" ToolTip="藍" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#3949AB" ToolTip="靛" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#8E24AA" ToolTip="紫" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#6D4C41" ToolTip="棕" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#9E9E9E" ToolTip="灰" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#000000" ToolTip="黑" Click="OnColorClick" />
                        <ToggleButton Style="{StaticResource Swatch}" Background="#FFFFFF" ToolTip="白" Click="OnColorClick" />
                    </StackPanel>
                    <ToggleButton x:Name="CustomSwatch" Style="{StaticResource Swatch}" Visibility="Collapsed" ToolTip="自訂顏色" Click="OnColorClick" />
                    <ToggleButton x:Name="PaletteToggle" Style="{StaticResource SizeDot}" ToolTip="調色盤" Margin="2,0,0,0" Click="OnPaletteClick" Content="&#xE790;" />
                    <ToggleButton x:Name="EyedropperToggle" Style="{StaticResource SizeDot}" ToolTip="吸管：從截圖上取色" Click="OnEyedropperClick" Content="&#xEF3C;" />
                    <StackPanel x:Name="OpacityOptions" Orientation="Horizontal">
                        <Rectangle Style="{StaticResource Divider}" Margin="5,4" />
                        <TextBlock Text="不透明度" Style="{StaticResource Label}" Margin="2,0,6,0" />
                        <Slider x:Name="OpacitySlider" Width="80" Minimum="10" Maximum="100" SmallChange="10" LargeChange="10" TickFrequency="10"
                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" Value="100" ValueChanged="OnOpacitySliderChanged" />
                        <local:NumberBox x:Name="OpacityValue" Minimum="10" Maximum="100" Suffix="%" Margin="6,0,4,0" Value="100" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <ContentControl x:Name="PaletteHost" Visibility="Collapsed" Focusable="False" />
        </StackPanel>
    </Border>
</UserControl>
