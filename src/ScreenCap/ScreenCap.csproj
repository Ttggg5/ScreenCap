<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+: needed for Windows.Media.Ocr and excluding the recording chrome from capture. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ScreenCap.ico</ApplicationIcon>
    <RootNamespace>ScreenCap</RootNamespace>
    <AssemblyName>ScreenCap</AssemblyName>
    <!-- Compared with the GitHub release tag (v1.1.0) by the self-update. -->
    <Version>1.1.0</Version>
    <!-- DPI awareness must stay in app.manifest for WPF; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespaces out of global scope to avoid WPF name clashes. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ScreenCap.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenCap.Tests" />
  </ItemGroup>

</Project>
